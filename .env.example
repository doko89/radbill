APP_ENV=dev
APP_PORT=3000

# sqlite (default) or postgres
DB_DRIVER=sqlite
SQLITE_PATH=./data/app.db
# DATABASE_URL=postgres://user:pass@localhost:5432/boilerplate?sslmode=disable

SESSION_SECRET=change-me-min-32-chars
SESSION_TTL_HOURS=12
UPLOAD_DIR=./data/uploads

# Object storage: local disk (default) or S3-compatible
# STORAGE_DRIVER=s3
# S3_ENDPOINT=localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=boilerplate
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_USE_SSL=false

# Seed admin (used only when users table is empty)
ADMIN_USER=admin
ADMIN_PASS=admin123

# --- External login (all disabled by default) ---
# OIDC (Google or any provider). Register this redirect URL in the console:
# http://localhost:3000/api/auth/oidc/callback
# OIDC_ENABLED=true
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=http://localhost:3000/api/auth/oidc/callback
# OIDC_LABEL=Google
# LDAP directory login (search mode shown; or set LDAP_USER_DN_TEMPLATE).
# Use ldaps:// in production; LDAP_CA_FILE pins a private CA (PEM).
# LDAP_ENABLED=true
# LDAP_URL=ldap://localhost:389
# LDAP_BASE_DN=dc=company,dc=com
# LDAP_BIND_DN=cn=reader,dc=company,dc=com
# LDAP_BIND_PASSWORD=
# LDAP_USER_FILTER=(uid=%s)
# LDAP_LABEL=Company Login
